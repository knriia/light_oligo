object FormPreview: TFormPreview
  Left = 400
  Height = 700
  Top = 200
  Width = 700
  Caption = 'Preview'
  ClientHeight = 700
  ClientWidth = 700
  OnClose = FormClose
  OnResize = FormResize
  Position = poScreenCenter
  object Chart1: TChart
    Left = 0
    Height = 700
    Top = 0
    Width = 700
    AxisList = <
      item
        Grid.Visible = False
        Intervals.Options = [aipUseCount, aipUseMaxLength, aipUseMinLength, aipUseNiceSteps]
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelFont.Orientation = 900
        Title.LabelBrush.Style = bsClear
      end
      item
        Grid.Visible = False
        Intervals.Count = 1
        Intervals.Options = [aipGraphCoords, aipUseCount, aipUseMaxLength, aipUseMinLength, aipUseNiceSteps]
        Alignment = calBottom
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelBrush.Style = bsClear
      end>
    Title.Text.Strings = (
      'TAChart'
    )
    Toolset = ChartToolset1
    Align = alLeft
    object BS_Series: TBubbleSeries
      BubbleBrush.Color = clRed
      BubblePen.Color = clRed
      BubblePen.Width = 2
    end
    object PS_Series: TPolygonSeries
      Pen.Color = clBlue
    end
  end
  object ChartToolset1: TChartToolset
    Left = 24
    Top = 24
    object ChartToolset1ZoomMouseWheelTool1: TZoomMouseWheelTool
      ZoomFactor = 1.1
    end
    object ChartToolset1ZoomDragTool1: TZoomDragTool
      Shift = [ssLeft]
      Brush.Style = bsClear
    end
    object ChartToolset1PanDragTool1: TPanDragTool
      Shift = [ssRight]
    end
  end
end
