  "rule3": {
    "enabled": true,
    "logic": [
      "OligoSlices",
      "AutomationDocumentStorage",
      "DispenserConfigStorage",
      "WindowSettingsStorage"
    ],
    "exceptions": []
  },
  "mapping_notes": [
    "WinProcessUtils сейчас лежит в src/laser, как и требуется целевой картой.",
    "LightOligo — program, а не unit; правило 2 применяется только к unit.",
    "EzCadApi (Graphics) и CommonUtils (Grids) временно исключены из правила 2: LCL-зависимость нужно убрать отдельной задачей.",
    "AppComposition — composition root приложения, ему разрешено собирать LCL-формы."
  ]
}
